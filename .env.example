# ============================================================
# Pandora Paradox — API keys for data collection
# Copy this file to ".env" and fill in your keys, then run:
#   set -a; source .env; set +a        # load into the shell
# (.env is gitignored — your keys are never committed.)
# ============================================================

# TMDB — free.  https://www.themoviedb.org/settings/api
# Used by: seed builder, base collectors, subtitle lookup.
TMDB_API_KEY=

# OMDb — free (1,000 req/day).  https://www.omdbapi.com/apikey.aspx
# Used by: awards collector (06_1).
OMDB_API_KEY=

# SerpAPI — paid (Google Trends proxy).  https://serpapi.com/manage-api-key
# ~1 search per film; the ~$50 tier covers a full ~350-film run.
SERPAPI_KEY=

# YouTube Data API v3 — free.  https://console.cloud.google.com
# Enable "YouTube Data API v3" for your project, then create an API key.
# Used by: trailer collectors (07, 09).
YOUTUBE_API_KEY=
# (GOOGLE_API_KEY is accepted as an alias for the YouTube key.)
GOOGLE_API_KEY=

# Reddit — free, STRONGLY RECOMMENDED. Reddit now 403-blocks anonymous requests.
# Create a "script" app at https://www.reddit.com/prefs/apps (redirect uri can be
# http://localhost:8080). client_id is the string under the app name; secret is
# the "secret" field. Without these the collector falls back to the public
# endpoint (often blocked).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: a descriptive UA Reddit asks for, e.g. "pandora/1.0 by u/yourname"
REDDIT_USER_AGENT=
